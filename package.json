{
  "name": "watch-it",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace=server",
    "start": "npm run start --workspace=server",
    "test:browser": "playwright test",
    "test:live": "node scripts/live-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "audit:release": "node scripts/audit.mjs",
    "check:release": "node scripts/release-check.mjs"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "license": "MIT"
}
