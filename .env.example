# TMDB API v3 key (free): https://www.themoviedb.org/settings/api  -- REQUIRED
TMDB_API_KEY=

# OMDb API key (free, 1000 req/day): https://www.omdbapi.com/apikey.aspx
# Optional. Without it, Rotten Tomatoes / IMDb / Metacritic scores show "unavailable".
OMDB_API_KEY=

# Host port the app is served on
PORT=8300

# Timezone used for cron schedules and "tonight" calculations
TZ=America/New_York
