# Recommended: leave blank and paste your TMDB key into Settings > API keys.
# Optional environment override: TMDB API Key from https://www.themoviedb.org/settings/api
# Use the API Key, not the API Read Access Token. See docs/INSTALL.md.
# After editing this file as .env, run: docker compose up -d --no-build
TMDB_API_KEY=

# Optional OMDb override (or use Settings): https://www.omdbapi.com/apikey.aspx
# Optional. Without it, Rotten Tomatoes / IMDb / Metacritic scores show "unavailable".
OMDB_API_KEY=

# Optional single-user login. Leave blank to keep login disabled.
# Use at least 12 characters. This secret is not included in profile backups.
WATCH_IT_PASSWORD=

# Set true only when accessing Watch It through HTTPS.
WATCH_IT_SECURE_COOKIE=false

# Host port the app is served on
PORT=8300

# Docker host interface. Set a specific LAN IP to allow LAN clients.
BIND_ADDRESS=127.0.0.1

# For a downloaded release, set its loaded versioned tag and use --no-build.
WATCH_IT_IMAGE=watch-it:local

# Native Node listener (Docker sets its own internal HOST=0.0.0.0).
HOST=127.0.0.1

# Optional exact reverse-proxy IPs or CIDRs, comma separated. Blank trusts none.
WATCH_IT_TRUSTED_PROXIES=

# Daily image-cache pruning limits.
IMAGE_CACHE_MB=256
# Maximum 90 days; older provider images are downloaded again.
IMAGE_CACHE_DAYS=90

# Optional daily profile backups. Blank disables scheduling.
# In Docker, /data/scheduled-backups is inside the existing installation volume.
BACKUP_DIR=
BACKUP_RETENTION=7

# Timezone used for cron schedules and "tonight" calculations
TZ=America/New_York
